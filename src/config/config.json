{
  "site": {
    "title": "Avivaria",
    "base_url": "https://christophehertigers.github.io",
    "base_path": "/avivaria-website",
    "trailing_slash": false,
    "favicon": "/avivaria-website/images/favicon.ico",
    "logo": "/avivaria-website/images/logo.png",
    "logo_darkmode": "/avivaria-website/images/logo.png",
    "logo_width": "182",
    "logo_height": "50",
    "logo_text": "Avivaria"
  },

  "settings": {
    "search": false,
    "sticky_header": true,
    "theme_switcher": false,
    "default_theme": "system",
    "pagination": 10,
    "summary_length": 200,
    "blog_folder": "blog",
    "news_folder": "news"
  },

  "announcement": {
    "enable": false,
    "content": "<span class='text-center block'>♥️ Loving Astroplate? <a class='underline' href='https://github.com/zeon-studio/astroplate' target='_blank' rel='noopener'>Please ⭐️ on Github</a></span>",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "© 2026 Avivaria."
  },

  "navigation_button": {
    "enable": false,
    "label": "Github",
    "link": "https://github.com/zeon-studio/astroplate"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": false,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "Avivaria",
    "meta_image": "/avivaria-website/images/og-image.png",
    "meta_description": "Avivaria homepage"
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
