{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "tamme-watervogels",
        "tamme-parkvogels"
      ]
    },
    "picture": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "image",
        "alt",
        "width",
        "height"
      ]
    },
    "draft": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category"
  ]
}